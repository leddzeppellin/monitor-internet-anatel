root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# O Windows PowerShell 5.1 interpreta arquivos sem BOM como ANSI e corrompe
# qualquer texto acentuado. Os .ps1 precisam ser gravados como UTF-8 com BOM.
[*.ps1]
charset = utf-8-bom

[*.{html,css,js,json,md,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
